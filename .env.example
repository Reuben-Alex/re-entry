# Copy this file to .env and fill in real values. Never commit .env itself.

# Nebius Token Factory — used for Nemotron Nano / Ultra / Super calls
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model identifiers on Token Factory (confirm exact strings in the Nebius
# model catalog before running — these are placeholders)
MODEL_NANO=nvidia/nemotron-3-nano
MODEL_SUPER=nvidia/nemotron-3-super
MODEL_ULTRA=nvidia/nemotron-3-ultra

# Tavily — used for exploit-precedent search
TAVILY_API_KEY=

# Contree / Nebius Sandboxes — used for forked EVM execution
# (leave blank while developing locally against Anvil; fill in once you
# move from local Anvil to real Contree sandboxes)
CONTREE_API_TOKEN=
CONTREE_PROJECT_ID=

# Local Anvil RPC endpoint (used during local development, and as the
# fallback path if Contree is unavailable close to demo time)
LOCAL_RPC_URL=http://127.0.0.1:8545

# Sandbox mode: local (Anvil) or contree (Nebius Sandboxes)
SANDBOX_MODE=local

# Retry budgets
MAX_RETRY_ATTEMPTS=3
MAX_COMPILE_RETRIES=3
LLM_TIMEOUT_SECONDS=60
