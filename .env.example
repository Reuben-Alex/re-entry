# Copy this file to .env and fill in real values. Never commit .env itself.

# Nebius Token Factory — used for Nemotron Nano / Ultra / Super calls
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model identifiers on Token Factory (copy from Models page → Copy model ID)
# Catalog: https://tokenfactory.nebius.com/model-catalog.md
# Nano  — recon / risk scanning (cheap, fast)
MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Super — evidence report summarization
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# Ultra — exploit Solidity generation (deep reasoning)
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily — used for exploit-precedent search
TAVILY_API_KEY=

# Stub precedent when Tavily key is unset (local demo only)
DEMO_SKIP_TAVILY=false

# Nebius Sandboxes (Contree) — cloud-isolated EVM execution with branching
# Token: same Nebius API key as Token Factory, OR request early access at
# https://contree.dev (fill the form — they email you when approved)
# Project ID: Nebius console → your project → copy Project ID
# Quick setup: pip install contree-cli && contree auth
CONTREE_API_TOKEN=
CONTREE_PROJECT_ID=
# Aliases the SDK also accepts (if set, CONTREE_* can stay blank):
# NEBIUS_API_KEY=        (same key as above)
# NEBIUS_PROJECT_ID=     (same project ID as above)

# Local Anvil RPC endpoint (used when SANDBOX_MODE=local)
LOCAL_RPC_URL=http://127.0.0.1:8545

# Sandbox mode: local (Anvil on your machine) or contree (Nebius Sandboxes)
SANDBOX_MODE=local

# Retry budgets
MAX_RETRY_ATTEMPTS=3
MAX_COMPILE_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# After exploit success: generate patch + verify fix blocks replay
ENABLE_PATCH_VERIFY=true

# Include teammate blind contract in deploy/pipeline (requires real bug in VulnerableBlind.sol)
INCLUDE_BLIND=false
